# Amazon's 2 GB kernel source tarball and what is extracted from it (see README: "Reference source")
src/

# Built module zips (build with tools/build_zip.py). Only the current release and its checksum are tracked;
# older dev builds stay local. When you cut a new version, add its zip to the allow-list below.
dist/*
!dist/firecube_lldv-v0.3.2.zip
!dist/SHA256SUMS

