#!/system/bin/sh
# lldv - settings and status for the Fire TV Cube 3 Dolby Vision (LLDV) module. Run it as root:
#
#   su -c /data/adb/modules/firecube_lldv/lldv show
#
#   lldv show                      current settings, what the display reports, watcher state, recent log
#   lldv list                      the selectable maxLum values and colour-primary presets
#   lldv set maxlum <cd/m2>|0      peak luminance to advertise (nearest of 32 steps; 0 = base block's own value)
#   lldv set primaries <preset>    BT709 | BT2020 | DCI-P3 | LS12000 | base (= the base block's own primaries)
#   lldv cycle                     next primaries preset: base > BT709 > BT2020 > DCI-P3 > LS12000 > base
#   lldv reset [maxlum|primaries]  remove the override(s); the module's lldv.conf defaults apply again
#   lldv edid [orig]               the EDID as hex, 16 bytes per line, ready to paste into an EDID analyzer.
#                                  Default = the live EDID the kernel holds now (includes the injected block);
#                                  `orig` = the display's own EDID as the module saved it before injecting.
#                                  Only the hex goes to stdout; a one-line summary (blocks, header, checksums)
#                                  goes to stderr, so `lldv edid > edid.txt` captures just the hex.
#   lldv log [lines]               tail of /data/local/tmp/lldv.log
#
# Changes are written to /data/adb/lldv.conf (survives module updates); the running watcher picks them up within
# a few seconds and re-injects (the screen blinks once). Nothing here touches the display directly.

MODDIR=${LLDV_MODDIR:-${0%/*}}
[ -f "$MODDIR/lldv_cfg.sh" ] || MODDIR=/data/adb/modules/firecube_lldv
E=/sys/class/amhdmitx/amhdmitx0
LOG=${LLDV_LOG:-/data/local/tmp/lldv.log}
# where `lldv edid` reads from (overridable for the unit tests)
EDID_LIVE=${LLDV_RAWEDID:-$E/rawedid}
EDID_ORIG=${LLDV_ORIGEDID:-/dev/lldv_o}

. "$MODDIR/lldv_lum.sh"
. "$MODDIR/lldv_gamut.sh"
. "$MODDIR/lldv_guard.sh"
. "$MODDIR/lldv_cfg.sh"
lldv_effective

die() {
    echo "lldv: $*" >&2
    exit 1
}

need_root() {
    [ "$(id -u)" = "0" ] || die "must run as root, e.g.  su -c '$0 <command>'"
}

reload() {
    . "$MODDIR/lldv_cfg.sh"
    lldv_effective
}

# set_key KEY VALUE: writes KEY=VALUE into the override file, replacing any earlier line for KEY.
# Values are validated by the callers, so the file stays safe to source.
set_key() {
    _tmp="$OVERRIDE.tmp"
    : > "$_tmp" || die "cannot write $_tmp"
    [ -f "$OVERRIDE" ] && grep -v "^$1=" "$OVERRIDE" > "$_tmp"
    echo "$1=$2" >> "$_tmp"
    chmod 600 "$_tmp"
    chown 0:0 "$_tmp" 2>/dev/null
    mv "$_tmp" "$OVERRIDE" || die "cannot update $OVERRIDE"
}

# drop_key KEY: removes the line for KEY; the file goes away when nothing is left
drop_key() {
    [ -f "$OVERRIDE" ] || return 0
    _tmp="$OVERRIDE.tmp"
    grep -v "^$1=" "$OVERRIDE" > "$_tmp"
    if [ -s "$_tmp" ]; then
        chmod 600 "$_tmp"
        chown 0:0 "$_tmp" 2>/dev/null
        mv "$_tmp" "$OVERRIDE"
    else
        rm -f "$_tmp" "$OVERRIDE"
    fi
}

watcher_running() {
    [ -f /dev/lldv_watch.pid ] && kill -0 "$(cat /dev/lldv_watch.pid 2>/dev/null)" 2>/dev/null
}

after_change() {
    reload
    echo "effective VSVDB now: $VSVDB_EFF"
    [ -n "$CFG_ERRORS" ] && echo "WARNING:$CFG_ERRORS"
    if watcher_running; then
        echo "the watcher applies this within a few seconds if the display is being handled by the module (the screen blinks once)"
    else
        echo "note: the watcher is not running (module disabled or not yet booted); it applies this after the next start"
    fi
}

cmd_show() {
    echo "== settings (defaults < $MODDIR/lldv.conf < $OVERRIDE)"
    echo "base VSVDB : $VSVDB"
    echo "primaries  : ${PRIMARIES:-base block's own}"
    if [ -n "$MAXLUM" ] && [ "$MAXLUM" != "0" ]; then
        _r=$(lldv_lum_nearest "$MAXLUM")
        case "$_r" in
            ERR:*) echo "maxlum     : $MAXLUM  (${_r#ERR:})" ;;
            *) echo "maxlum     : $MAXLUM -> code ${_r%% *} = ${_r#* } cd/m2" ;;
        esac
    else
        echo "maxlum     : base block's own"
    fi
    echo "effective  : $VSVDB_EFF"
    [ -n "$CFG_ERRORS" ] && echo "WARNING    :$CFG_ERRORS"
    [ -n "$LLDV_CFG_WARN" ] && echo "WARNING    : $LLDV_CFG_WARN"
    [ -f "$OVERRIDE" ] && echo "override   : $OVERRIDE: $(sed 's/WEB_PASS=[^ ]*/WEB_PASS=********/g' "$OVERRIDE" | tr '\n' ' ')" || echo "override   : none"
    echo
    echo "== display"
    echo "hpd_state  : $(cat $E/hpd_state 2>/dev/null | tr -d '\r\n ')   sink_type: $(cat $E/sink_type 2>/dev/null | tr -d '\r\n ')"
    echo "status     : $(cat $E/hdmi_hdr_status 2>/dev/null | tr -d '\r\n')"
    echo "dv_cap2    : $(head -1 $E/dv_cap2 2>/dev/null)"
    _v=$(grep -m1 'VSVDB:' $E/dv_cap2 2>/dev/null)
    [ -n "$_v" ] && echo "reported   : ${_v#*VSVDB: }"
    echo
    echo "== watcher"
    if watcher_running; then echo "running, pid $(cat /dev/lldv_watch.pid)"; else echo "NOT running"; fi
    [ -f "$MODDIR/disable" ] && echo "module is DISABLED ($MODDIR/disable exists)"
    echo
    echo "== last log lines"
    tail -n 6 "$LOG" 2>/dev/null
}

cmd_list() {
    echo "maxlum: whole number of cd/m2; the nearest of these 32 steps is used (code = position - 1):"
    echo "  $LLDV_LUM_NITS"
    echo "  0 = keep the base block's own value"
    echo
    echo "primaries presets (stored in 1/256 steps):"
    echo "  BT709           R 0.6400,0.3300  G 0.3000,0.6000  B 0.1500,0.0600"
    echo "  BT2020          R 0.7080,0.2920  G 0.1700,0.7970  B 0.1310,0.0460"
    echo "  DCI-P3          R 0.6800,0.3200  G 0.2650,0.6900  B 0.1500,0.0600"
    echo "  LS12000         R 0.6670,0.3310  G 0.3140,0.6720  B 0.1480,0.0420   (LS12000 Native)"
    echo "  base            keep the primaries of the base block"
}

cmd_set() {
    need_root
    case "$1" in
        maxlum)
            [ -n "$2" ] || die "usage: lldv set maxlum <cd/m2>|0"
            if [ "$2" = "0" ]; then
                set_key MAXLUM 0
                echo "MAXLUM=0 (base block's own value)"
            else
                _r=$(lldv_lum_nearest "$2")
                case "$_r" in ERR:*) die "${_r#ERR:}" ;; esac
                set_key MAXLUM "${_r#* }"
                echo "MAXLUM=${_r#* } (asked for $2, nearest selectable step, code ${_r%% *})"
            fi
            after_change
            ;;
        primaries)
            [ -n "$2" ] || die "usage: lldv set primaries BT709|BT2020|DCI-P3|LS12000|base"
            _base=$(echo "$2" | tr 'A-Z' 'a-z')
            if [ "$_base" = "base" ]; then
                set_key PRIMARIES ""
                echo "PRIMARIES= (base block's own)"
            else
                _c=$(lldv_primaries_canon "$2")
                case "$_c" in ERR:*) die "${_c#ERR:}" ;; esac
                set_key PRIMARIES "$_c"
                echo "PRIMARIES=$_c"
            fi
            after_change
            ;;
        *) die "usage: lldv set maxlum <cd/m2>|0   or   lldv set primaries <preset>" ;;
    esac
}

cmd_cycle() {
    need_root
    case "$PRIMARIES" in
        "") _next=BT709 ;;
        BT709) _next=BT2020 ;;
        BT2020) _next=DCI-P3 ;;
        DCI-P3) _next=LS12000 ;;
        *) _next=base ;;
    esac
    echo "primaries: ${PRIMARIES:-base} -> $_next"
    cmd_set primaries "$_next"
}

cmd_reset() {
    need_root
    case "$1" in
        "") rm -f "$OVERRIDE"; echo "removed $OVERRIDE" ;;
        maxlum) drop_key MAXLUM; echo "MAXLUM override removed" ;;
        primaries) drop_key PRIMARIES; echo "PRIMARIES override removed" ;;
        *) die "usage: lldv reset [maxlum|primaries]" ;;
    esac
    after_change
}

# edid_summary HEX LABEL: one line on stderr: block count, header, per-block checksums. Expects uppercase hex.
edid_summary() {
    _eh=$1
    _el=${#_eh}
    _nb=$((_el / 256))
    _msg="# $2: $_nb blocks ($((_el / 2)) bytes)"
    [ $((_el % 256)) -eq 0 ] || _msg="$_msg, WARNING not a whole number of 128-byte blocks"
    [ "${_eh:0:16}" = "00FFFFFFFFFFFF00" ] || _msg="$_msg, BAD HEADER"
    _bad=
    _b=0
    while [ $_b -lt $_nb ]; do
        _blk=${_eh:$((_b * 256)):256}
        _s=0
        _i=0
        while [ $_i -lt 256 ]; do
            _s=$((_s + 0x${_blk:$_i:2}))
            _i=$((_i + 2))
        done
        [ $((_s % 256)) -eq 0 ] || _bad="$_bad $_b"
        _b=$((_b + 1))
    done
    if [ -n "$_bad" ]; then
        _msg="$_msg, BAD CHECKSUM in block(s):$_bad"
    else
        _msg="$_msg, header and checksums ok"
    fi
    echo "$_msg" >&2
}

# edid_lines HEX: 16 bytes per line, bytes separated by single spaces
edid_lines() {
    _lh=$1
    _o=0
    while [ $_o -lt ${#_lh} ]; do
        _ln=${_lh:$_o:32}
        _out=
        _i=0
        while [ $_i -lt ${#_ln} ]; do
            _out="$_out${_ln:$_i:2} "
            _i=$((_i + 2))
        done
        echo "${_out% }"
        _o=$((_o + 32))
    done
}

cmd_edid() {
    case "$1" in
        "" | live)
            _what="live EDID"
            # cat, not "tr < file": a redirect that fails prints a raw shell error before our message
            _hex=$(cat "$EDID_LIVE" 2>/dev/null | tr -d '\r\n ')
            [ -n "$_hex" ] || die "no EDID available from $EDID_LIVE (display disconnected, or the HDMI driver is not ready)"
            ;;
        orig)
            _what="original EDID (as saved before the module injected)"
            [ -s "$EDID_ORIG" ] || die "no saved original EDID: the module has not injected since boot, so the live EDID is already the display's own (use: lldv edid)"
            _hex=$(od -An -v -tx1 "$EDID_ORIG" | tr -d ' \012')
            ;;
        *) die "usage: lldv edid [orig]" ;;
    esac
    case "$_hex" in
        *[!0-9A-Fa-f]*) die "the EDID source did not contain plain hex" ;;
    esac
    _hex=$(echo "$_hex" | tr 'a-f' 'A-F')
    edid_summary "$_hex" "$_what"
    edid_lines "$_hex"
}

case "$1" in
    show | "") cmd_show ;;
    list) cmd_list ;;
    set) shift; cmd_set "$@" ;;
    cycle) cmd_cycle ;;
    reset) shift; cmd_reset "$@" ;;
    edid) shift; cmd_edid "$@" ;;
    log) tail -n "${2:-30}" "$LOG" ;;
    *) die "unknown command '$1' (show, list, set, cycle, reset, edid, log)" ;;
esac
